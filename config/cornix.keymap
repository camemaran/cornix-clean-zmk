#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // 1. tap_dance（ShiftとCapsLock、および右端のMission Control用）
        td_shift_caps: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPSLOCK>;
        };

        td_shift_mission: tap_dance_mission {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&kp C_AC_DESKTOP_SHOW_ALL_WINDOWS>;
        };

        // 2. hold-tap（ZMK標準の安全なホールド・タップ挙動）
        mt_esc_ctrl: mt_esc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";           // ショートカットが100%確実に発動する設定
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;          // 200ms以内の連打はタップに固定（連打の詰まりを完全解消）
            retro-tap;
        };

        mt_ret_cmd: mt_ret_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            retro-tap;
        };

        mt_tab_l2: mt_tab_l2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;       // 長押しでRaiseレイヤー、単押しでTAB
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;          // TABの超高速連打を快適に維持！
            retro-tap;
        };

        mt_del_l1: mt_del_l1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;       // 長押しでLowerレイヤー、単押しでBSPC
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;          // BSPCの超高速連打を快適に維持！
            retro-tap;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0. ベースレイヤー（Default：12-12-14-12個完全一致）
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB         &kp Q    &kp W     &kp E             &kp R      &kp T                               &kp Y      &kp U      &kp I          &kp O          &kp P         &kp BSPC
&kp LCTRL       &kp A    &kp S     &kp D             &kp F      &kp G                               &kp H      &kp J      &kp K          &kp L          &kp MINUS     &kp ENTER
&td_shift_caps  &kp Z    &kp X     &kp C             &kp V      &kp B          &kp C_MUTE  &none    &kp N      &kp M      &kp JP_COMMA   &kp JP_DOT     &kp UP        &td_shift_mission
&mo 4 &kp LALT &kp LGUI &mt_esc_ctrl LCTRL ESC &kp SPACE &mt_tab_l2 2 TAB &mt_del_l1 1 BSPC &kp SPACE &mt_ret_cmd LGUI DEL &kp LEFT &kp DOWN &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 1. Lowerレイヤー（★日本語記号・算数・テンキー完全最適化版：12-12-14-12個完全一致）
        Lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))   &kp SEMI            &kp COLON                               &kp KP_MINUS   &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_COMMA &trans
&trans  &kp EQUAL       &kp FSLH        &kp ASTERISK     &kp MINUS           &kp PLUS                                &kp KP_N0      &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_DOT   &trans
&trans  &kp DLLR        &kp INTERNATIONAL_6 &kp INTERNATIONAL_3 &kp RA(KP_SLASH) &kp KP_MULTIPLY &kp C_MUTE  &none   &kp F24        &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp UP       &trans
&trans  &trans          &trans          &trans           &trans              &trans                                  &trans         &trans     &trans     &trans      &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 2. Raiseレイヤー（12-12-14-12個完全一致）
        Raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &kp LT     &kp GT      &kp LPAR     &kp RPAR     &none                          &kp EXCL    &kp QMARK    &kp AMPS    &kp PRCNT    &none       &trans
&trans  &kp LEFT   &kp DOWN    &kp UP       &kp RIGHT    &none                          &kp AT      &kp UNDER    &kp HASH    &kp TILDE    &kp PIPE    &trans
&trans  &kp LBRC   &kp RBRC    &kp LBKT     &kp RBKT     &none     &kp C_MUTE  &none    &kp GRAVE   &kp SQT      &kp DQT     &kp CARET    &kp UP      &trans
&trans  &trans     &trans      &trans       &trans       &trans                                      &trans       &trans      &trans       &trans      &trans      &trans
            >; 
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 3. 予備レイヤー（旧・薙刀レイヤー：今回は英語配列専用のクリーンな透過仕様にします：12-12-14-12個完全一致）
        naginata_layer {
            display-name = "Extra1";
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                  &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans                  &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans  &kp C_MUTE &none &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp SPACE  &trans                  &trans  &kp SPACE  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 4. システムレイヤー（3rd：12-12-14-12個完全一致）
        third_layer {
            display-name = "3rd";
            bindings = <
&trans  &kp N1       &kp N2           &kp N3         &kp N4         &kp N5                          &kp N6        &kp N7        &kp N8       &kp N9          &kp N0   &trans
&trans  &kp KP_PLUS  &kp KP_ASTERISK  &kp KP_EQUAL   &kp KP_SLASH   &none                           &kp LS(LEFT)  &kp LS(DOWN)  &kp LS(UP)   &kp LS(RIGHT)   &none    &trans
&trans  &bt BT_SEL 0 &bt BT_SEL 1     &bt BT_SEL 2   &bt BT_CLR     &none   &kp C_MUTE  &none       &kp HOME      &kp PG_DN     &kp PG_UP    &kp END         &kp UP   &trans
&trans  &trans       &trans           &trans         &kp SPACE      &trans                                        &trans        &kp SPACE    &trans          &trans   &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // 5. 予約レイヤー
        extra2 {
            display-name = "Extra2";
            status = "reserved";
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
